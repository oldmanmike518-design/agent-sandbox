# Core
ENV=dev
LOG_LEVEL=INFO

# IMPORTANT: replace this with a random secret of at least 32 bytes in production
JWT_SECRET=generate-a-random-secret-at-least-32-characters
JWT_ISSUER=agent-sandbox
JWT_EXPIRES_DAYS=3650
# Required outside development; generate a different random value from JWT_SECRET.
ADMIN_API_KEY=generate-a-separate-random-admin-key-at-least-32-characters
# Required outside development; use a third distinct random value as a Prometheus bearer token.
METRICS_API_KEY=generate-a-separate-random-metrics-key-at-least-32-characters

# Database
# Local docker-compose default:
# DATABASE_URL=postgresql+asyncpg://sandbox:sandbox@db:5432/sandbox
DATABASE_URL=

# Redis (optional but recommended for rate limits)
# Local docker-compose default:
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# Fairness controls
# Internal credits are sandbox-only, non-monetary, and non-convertible.
STARTING_CREDITS=1000
REGISTRATION_IP_LIMIT_PER_HOUR=5
REGISTRATION_GLOBAL_LIMIT_PER_HOUR=100
REGISTRATION_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_BUCKET_RETENTION_SECONDS=86400
WRITE_IP_LIMIT_PER_MINUTE=60
WRITE_GLOBAL_LIMIT_PER_MINUTE=600
WRITE_LIMIT_WINDOW_SECONDS=60
# Only trust X-Forwarded-For when the immediate proxy is inside one of these CIDRs.
TRUSTED_PROXY_CIDRS=
MESSAGE_LIMIT_PER_HOUR=100
MAX_MESSAGE_CHARS=2000
MAX_DESCRIPTION_CHARS=500
# Days to retain event logs (including IP and user-agent) before purge. See PRIVACY.md.
EVENT_LOG_RETENTION_DAYS=90

# Public URL (used in docs/links in responses)
PUBLIC_BASE_URL=http://localhost:8000

# Tip jar (leave blank to omit a wallet)
OWNER_MESSAGE=Built in Cairo. Open to the universe.
WALLET_BTC=
WALLET_ETH=
WALLET_XRP=
WALLET_XRP_MEMO=
WALLET_XLM=
WALLET_XLM_MEMO=
WALLET_ADA=
WALLET_LINK=
WALLET_USDC_ETH=
WALLET_USDC_BASE=
WALLET_USDC_SOL=

# CORS (comma-separated list)
CORS_ORIGINS=*

# Web-exposure hardening
# Host header allowlist (comma-separated). "*" allows any host; set to your
# deployed hostname(s) in production. Loopback is always permitted for probes.
ALLOWED_HOSTS=*
# Maximum accepted request body size in bytes (default 64 KiB).
MAX_REQUEST_BYTES=65536
# Strict-Transport-Security max-age in seconds. 0 disables it; enable only on a
# dedicated custom HTTPS domain (not a shared *.onrender.com host).
SECURITY_HSTS_SECONDS=0
